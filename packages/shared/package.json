{
  "name": "@xcodit/shared",
  "version": "0.1.0",
  "description": "Wire protocol, specialist roles and permission rules shared by the xcodit CLI and service",
  "license": "Apache-2.0",
  "homepage": "https://xcodit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcodit/xcodit.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --clean --target node22"
  },
  "dependencies": { "zod": "^3.23.8" },
  "devDependencies": { "tsup": "^8.5.1", "typescript": "^5.6.0" }
}
